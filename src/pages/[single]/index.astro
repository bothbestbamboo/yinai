---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubBanner from '../../components/SubBanner.astro';
import { SITE } from '../../data/site';
import singlePagesData from '../../data/singlePages.json';

interface SinglePageRecord {
  title: string;
  keywords: string;
  description: string;
  bodyHtml: string;
}

interface PageMeta {
  group: 'about' | 'jiameng' | 'product';
  label: string;
  en: string;
  parentLabel: string;
  parentHref: string;
}

const ABOUT_TABS = [
  { key: 'about', href: '/about/', icon: '/images/g1.png', label: '公司概况' },
  { key: 'nianzhi', href: '/nianzhi/', icon: '/images/g2.png', label: '公司年志' },
  { key: 'rongyu', href: '/rongyu/', icon: '/images/g3.png', label: '公司荣誉' },
];

const JIAMENG_TABS = [
  { key: 'jiameng', href: '/jiameng/', icon: '/images/six-1.png', label: '加盟前景' },
  { key: 'youshi', href: '/youshi/', icon: '/images/six-2.png', label: '加盟优势' },
  { key: 'zhichi', href: '/zhichi/', icon: '/images/six-3.png', label: '加盟支持' },
  { key: 'tiaojian', href: '/tiaojian/', icon: '/images/six-4.png', label: '加盟条件' },
  { key: 'zhongduan', href: '/zhongduan/', icon: '/images/six-5.png', label: '终端形象' },
  { key: 'shenqing', href: '/shenqing/', icon: '/images/six-6.png', label: '加盟申请' },
];

export async function getStaticPaths() {
  const PAGE_META: Record<string, PageMeta> = {
    about: { group: 'about', label: '公司概况', en: 'COMPANY PROFILE', parentLabel: '关于宜耐', parentHref: '/about/' },
    nianzhi: { group: 'about', label: '公司年志', en: 'MILESTONES', parentLabel: '关于宜耐', parentHref: '/about/' },
    rongyu: { group: 'about', label: '公司荣誉', en: 'HONORS & AWARDS', parentLabel: '关于宜耐', parentHref: '/about/' },
    jiameng: { group: 'jiameng', label: '加盟前景', en: 'MARKET PROSPECTS', parentLabel: '招商加盟', parentHref: '/jiameng/' },
    youshi: { group: 'jiameng', label: '加盟优势', en: 'OUR ADVANTAGES', parentLabel: '招商加盟', parentHref: '/jiameng/' },
    zhichi: { group: 'jiameng', label: '加盟支持', en: 'DEALER SUPPORT', parentLabel: '招商加盟', parentHref: '/jiameng/' },
    tiaojian: { group: 'jiameng', label: '加盟条件', en: 'REQUIREMENTS', parentLabel: '招商加盟', parentHref: '/jiameng/' },
    zhongduan: { group: 'jiameng', label: '终端形象', en: 'SHOWROOM IMAGE', parentLabel: '招商加盟', parentHref: '/jiameng/' },
    chanpinyoushi: { group: 'product', label: '产品优势', en: 'PRODUCT ADVANTAGES', parentLabel: '宜耐产品', parentHref: '/product/' },
  };

  const pages = singlePagesData as Record<string, SinglePageRecord>;
  return Object.keys(PAGE_META)
    .filter((key) => Boolean(pages[key]))
    .map((key) => ({
      params: { single: key },
      props: {
        pageKey: key,
        meta: PAGE_META[key],
        content: pages[key],
      },
    }));
}

const { pageKey, meta, content } = Astro.props;
const tabs = meta.group === 'about' ? ABOUT_TABS : meta.group === 'jiameng' ? JIAMENG_TABS : [];
---
<BaseLayout
  title={content.title}
  keywords={content.keywords}
  description={content.description}
  activeNav={meta.group}
>
  <SubBanner preset={meta.group} />

  <div class="w">
    <div class="posi">
      当前位置：<a href="/">首页</a> - <a href={meta.parentHref}>{meta.parentLabel}</a> - <span>{meta.label}</span>
    </div>
  </div>

  <div class="w">
    {tabs.length > 0 && (
      <div class="zs-six-2">
        <ul>
          {tabs.map((tab) => (
            <li class={tab.key === pageKey ? 'now' : ''}>
              <a href={tab.href}>
                <div><img src={tab.icon} alt={tab.label} /></div>
                <p>{tab.label}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <article class="zs-body">
      <header class="single-page-head">
        <h1>{meta.label}</h1>
        <span>{meta.en}</span>
      </header>

      <div
        class="single-page-content"
        set:html={content.bodyHtml.replace(/<img(?![^>]*\bloading=)/gi, '<img loading="lazy" decoding="async"')}
      />

      {meta.group === 'jiameng' && (
        <div class="jiameng-cta-box">
          <div class="jiameng-cta-text">
            <h3>有意携手宜耐地板开拓本地市场？</h3>
            <p>源头厂家直供，提供选址评估、店面设计、样品扶持与系统培训，欢迎各地经销商、设计师及装饰公司洽谈合作。</p>
          </div>
          <div class="jiameng-cta-actions">
            <a class="deta-btn-primary" href="/shenqing/">在线提交加盟申请 →</a>
            <a class="deta-btn-ghost" href={`tel:${SITE.phoneRaw}`}>招商热线：{SITE.phoneDisplay}</a>
          </div>
        </div>
      )}
    </article>
  </div>
</BaseLayout>