---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import SubBanner from '../../components/SubBanner.astro';
import { getAllNewsRaw, getMainNews, getNewsUrl } from '../../utils/content';

export async function getStaticPaths() {
  const allRaw = await getAllNewsRaw();
  const mainList = await getMainNews();

  return allRaw.map((entry) => {
    const idx = mainList.findIndex((m) => m.data.slugName === entry.data.slugName);
    return {
      params: { slug: entry.data.slugName },
      props: {
        entry,
        prevItem: idx >= 0 && idx < mainList.length - 1 ? mainList[idx + 1] : undefined,
        nextItem: idx > 0 ? mainList[idx - 1] : undefined,
      },
    };
  });
}

const { entry, prevItem, nextItem } = Astro.props;
const { Content } = await render(entry);

// 读取 Frontmatter 封面图（兼容 cover / image / thumb 字段）
const entryData = entry.data as Record<string, any>;
const coverImage = String(
  entryData.cover || entryData.image || entryData.thumb || ''
).trim();

// 自动去重检测：如果旧文章正文里已经包含同一张封面图，顶部不会重复渲染
const rawBody = entry.body ?? '';
let decodedCover = coverImage;
try {
  decodedCover = decodeURI(coverImage);
} catch {
  decodedCover = coverImage;
}
const isCoverAlreadyInBody = Boolean(
  coverImage &&
    (rawBody.includes(coverImage) || (decodedCover && rawBody.includes(decodedCover)))
);
const showCover = Boolean(coverImage && !isCoverAlreadyInBody);
---
<BaseLayout
  title={entry.data.title}
  keywords={entry.data.keywords}
  description={entry.data.description}
  activeNav="news"
>
  <SubBanner preset="news" />

  <div class="w">
    <div class="posi">
      当前位置：<a href="/">首页</a> - <a href="/news/">宜耐新闻</a> - <span>正文</span>
    </div>
  </div>

  <div class="w sub-layout">
    <Sidebar />

    <article class="news-deta">
      <div class="news-deta-cont">
        <header class="article-header">
          <h1>{entry.data.title}</h1>
          {entry.data.pubDate && (
            <p class="news-deta-p">发布日期：{entry.data.pubDate}</p>
          )}
        </header>

        {showCover && (
          <figure class="news-deta-cover">
            <img
              src={coverImage}
              alt={entry.data.title}
              loading="eager"
              decoding="async"
              onerror="this.parentElement.remove()"
            />
          </figure>
        )}

        <div class="news-deta-body">
          <Content />
        </div>
      </div>
      <div class="pian">
        <p>
          <span>上一篇：</span>
          {prevItem ? <a href={getNewsUrl(prevItem)}>{prevItem.data.title}</a> : <a href="/news/">返回列表</a>}
        </p>
        <p>
          <span>下一篇：</span>
          {nextItem ? <a href={getNewsUrl(nextItem)}>{nextItem.data.title}</a> : <a href="/news/">返回列表</a>}
        </p>
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .news-deta-cover {
    margin: 0 0 24px;
    border-radius: 8px;
    overflow: hidden;
    background: #f8fafc;
  }

  .news-deta-cover img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 500px;
    object-fit: cover;
    object-position: center;
  }

  @media (max-width: 767px) {
    .news-deta-cover {
      margin-bottom: 18px;
    }
    .news-deta-cover img {
      max-height: 300px;
    }
  }
</style>