---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import SubBanner from '../../components/SubBanner.astro';
import { getAllFaq, getFaqUrl } from '../../utils/content';

export async function getStaticPaths() {
  const list = await getAllFaq();
  return list.map((entry, idx) => ({
    params: { slug: entry.data.slugName },
    props: {
      entry,
      prevItem: idx < list.length - 1 ? list[idx + 1] : undefined,
      nextItem: idx > 0 ? list[idx - 1] : undefined,
    },
  }));
}

const { entry, prevItem, nextItem } = Astro.props;
const { Content } = await render(entry);
---
<BaseLayout
  title={entry.data.title}
  keywords={entry.data.keywords}
  description={entry.data.description}
  activeNav="news"
>
  <SubBanner preset="faq" />

  <div class="w">
    <div class="posi">
      当前位置：<a href="/">首页</a> - <a href="/faq/">常见问题</a> - <span>解答详情</span>
    </div>
  </div>

  <div class="w sub-layout">
    <Sidebar />

    <article class="news-deta">
      <div class="news-deta-cont">
        <header class="article-header">
          <h1>{entry.data.title}</h1>
          {entry.data.pubDate && (
            <p class="news-deta-p">发布日期：{entry.data.pubDate}</p>
          )}
        </header>
        <div class="news-deta-body">
          <Content />
        </div>
      </div>
      <div class="pian">
        <p>
          <span>上一篇：</span>
          {prevItem ? <a href={getFaqUrl(prevItem)}>{prevItem.data.title}</a> : <a href="/faq/">返回列表</a>}
        </p>
        <p>
          <span>下一篇：</span>
          {nextItem ? <a href={getFaqUrl(nextItem)}>{nextItem.data.title}</a> : <a href="/faq/">返回列表</a>}
        </p>
      </div>
    </article>
  </div>
</BaseLayout>