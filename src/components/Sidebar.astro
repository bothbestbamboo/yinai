---
import { getMainNews, getAllProducts, pickHotProducts, getNewsUrl, getProductUrl } from '../utils/content';

const latestNews = (await getMainNews()).slice(0, 7);
const allProducts = await getAllProducts();
const hotProducts = pickHotProducts(allProducts, 6);
---
<aside class="com-left">
  <div class="com-left-t">
    <div class="cf">
      <p class="b f20">最新动态</p>
      <span class="f18">NEWS</span>
    </div>
    <ul>
      {latestNews.map((item) => (
        <li>
          <a class="sidebar-news-link" href={getNewsUrl(item)} title={item.data.title}>
            <span class="sidebar-news-icon" aria-hidden="true">
              <svg viewBox="0 0 16 16" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 3.5 10.5 8 6 12.5"></polyline>
              </svg>
            </span>
            <span class="sidebar-news-text">{item.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="com-left-b">
    <div class="cf">
      <p class="b f20">热销商品</p>
      <span class="f18">HOT COMMODITY</span>
    </div>
    <ul class="border">
      {hotProducts.map((p) => (
        <li>
          <a href={getProductUrl(p)}>
            <img width="171" height="160" src={p.data.cover || '/images/logo.png'} alt={p.data.title} loading="lazy" />
            <p>
              {p.data.title}
              {p.data.model && (
                <>
                  <br />
                  <b>型号：</b>{p.data.model}
                </>
              )}
            </p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</aside>