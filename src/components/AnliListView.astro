---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from './Sidebar.astro';
import Pagination from './Pagination.astro';
import SubBanner from './SubBanner.astro';
import { getAnliUrl, formatShortDate, type AnliEntry } from '../utils/content';

interface Props {
  items: AnliEntry[];
  currentPage: number;
  totalPages: number;
}
const { items, currentPage, totalPages } = Astro.props;
---
<BaseLayout
  title={currentPage > 1 ? `工程案例 第${currentPage}页 | 宜耐地板` : '工程案例 | 地板安装 | 户外地板应用 | 板材使用'}
  keywords="宜耐, 地板, 户外地板, 竹板材, 安装, 应用"
  description="宜耐竹地板、重竹地板及户外高耐重竹地板全国酒店、公园、住宅工程安装案例展示。"
  activeNav="anli"
>
  <SubBanner preset="anli" />

  <div class="w">
    <div class="posi">
      当前位置：<a href="/">首页</a> - <span>工程案例</span>
    </div>
  </div>

  <div class="w sub-layout">
    <Sidebar />

    <section class="anli-list">
      <ul>
        {items.map((item) => {
          const desc = item.data.summary || item.data.description;
          return (
            <li>
              <a class="anli-list-thumb" href={getAnliUrl(item)} title={item.data.title}>
                <img
                  width="320"
                  height="210"
                  src={item.data.cover || '/images/logo.png'}
                  alt={item.data.title}
                  loading="lazy"
                />
              </a>
              <div class="anli-list-body">
                <div class="anli-list-meta">
                  <span class="anli-tag">工程实景</span>
                  {item.data.pubDate && (
                    <span class="anli-date">{formatShortDate(item.data.pubDate)}</span>
                  )}
                </div>
                <h3>
                  <a href={getAnliUrl(item)}>{item.data.title}</a>
                </h3>
                {desc && <p>{desc}</p>}
                <div class="anli-list-foot">
                  <a class="news-more" href={getAnliUrl(item)}>查看案例详情 →</a>
                </div>
              </div>
            </li>
          );
        })}
      </ul>

      <Pagination basePath="/anli" currentPage={currentPage} totalPages={totalPages} />
    </section>
  </div>
</BaseLayout>